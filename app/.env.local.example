# =====================================================================
# .env.local.example
# 이 파일을 .env.local로 복사한 뒤, 아래 3개 값을 Supabase 대시보드에서
# 가져온 실제 값으로 채워주세요.
#
# .env.local 파일은 .gitignore에 의해 자동으로 제외됩니다.
# 절대로 git commit 하지 마세요.
# =====================================================================

# Supabase Project URL (Project Settings → Data API)
# 형태: https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (Project Settings → API Keys → Publishable key)
# sb_publishable_... 로 시작
# 브라우저 노출 OK (RLS로 보호됨)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Secret key (Project Settings → API Keys → Secret key)
# sb_secret_... 로 시작
# ⚠ 절대 클라이언트에 노출 금지. 서버 전용.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SECRET_KEY

# 진행자 대시보드 비밀 경로 (URL의 [token] 부분)
# https://[도메인]/admin-XXXX 형태로 접속. 동엽님만 알고 있어야 함.
ADMIN_TOKEN=admin-u62chzb4
